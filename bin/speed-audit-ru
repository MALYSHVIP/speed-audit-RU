#!/usr/bin/env bash
set -Eeuo pipefail

APP_NAME="Speed Audit RU"
APP_VERSION="1.4.0"
CONFIG_FILE="/etc/speed-audit-ru/speed-audit-ru.conf"
DEFAULT_LIBRESPEED_SERVERS_URL="https://librespeed.org/backend-servers/servers.php"
DEFAULT_LIBRESPEED_SERVER_IDS=""
DEFAULT_HTTP_PROBE_URLS="https://speedtest.selectel.ru/100MB https://speedtest.wcloud.ru/100MB https://mirror.yandex.ru/ubuntu/ls-lR.gz https://speed.cloudflare.com/__down?bytes=33554432 https://proof.ovh.net/files/100Mb.dat https://cachefly.cachefly.net/100mb.test"

MENU_KEYS=()
MENU_TITLES=()
MENU_DESCRIPTIONS=()
NETWORK_ATTEMPTS=()
NETWORK_SAMPLES=()

NETWORK_SAMPLE_TARGET=3
NETWORK_MAX_SERVERS=8
NETWORK_DURATION=8
NETWORK_BUDGET=180
NETWORK_DEADLINE=0
NETWORK_WORK_DIR=""
LIBRESPEED_SERVER_IDS=""
LIBRESPEED_SERVERS_URL="${DEFAULT_LIBRESPEED_SERVERS_URL}"
LIBRESPEED_IP_VERSION="4"
HTTP_PROBE_URLS="${DEFAULT_HTTP_PROBE_URLS}"

NETWORK_TEST_OK=0
NETWORK_TEST_BACKEND=""
NETWORK_TEST_PROVIDER=""
NETWORK_TEST_SERVER=""
NETWORK_TEST_UPLOAD_SERVER=""
NETWORK_TEST_PACKET_LOSS=""
NETWORK_TEST_PING=""
NETWORK_TEST_JITTER=""
NETWORK_TEST_DOWNLOAD=""
NETWORK_TEST_UPLOAD=""
NETWORK_TEST_NOTE=""
NETWORK_TEST_LIMITED=0

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

float_ge() {
  awk -v a="$1" -v b="$2" 'BEGIN { exit !(a >= b) }'
}

float_le() {
  awk -v a="$1" -v b="$2" 'BEGIN { exit !(a <= b) }'
}

format_mb() {
  awk -v mb="$1" 'BEGIN {
    if (mb >= 1024) {
      printf "%.1f ГБ", mb / 1024
    } else {
      printf "%d МБ", mb
    }
  }'
}

format_percent() {
  awk -v value="$1" 'BEGIN { printf "%.1f%%", value }'
}

trim() {
  awk '{$1=$1; print}'
}

dir_size_mb() {
  local path="$1"
  du -sm "$path" 2>/dev/null | awk '{print $1 + 0}'
}

print_line() {
  printf '%s\n' "============================================================"
}

print_block_title() {
  printf '\n%s\n' "$1"
}

pause_before_menu_return() {
  if [[ -t 0 && -t 1 ]]; then
    printf '\nНажмите Enter, чтобы вернуться в меню...'
    read -r _ || true
  fi
}

cpu_usage_percent() {
  local user nice system idle iowait irq softirq steal guest guest_nice
  local prev_idle prev_total idle_now total_now idle_delta total_delta

  read -r _ user nice system idle iowait irq softirq steal guest guest_nice < /proc/stat
  prev_idle=$((idle + iowait))
  prev_total=$((user + nice + system + idle + iowait + irq + softirq + steal))
  sleep 1
  read -r _ user nice system idle iowait irq softirq steal guest guest_nice < /proc/stat
  idle_now=$((idle + iowait))
  total_now=$((user + nice + system + idle + iowait + irq + softirq + steal))

  idle_delta=$((idle_now - prev_idle))
  total_delta=$((total_now - prev_total))

  awk -v idle_delta="$idle_delta" -v total_delta="$total_delta" 'BEGIN {
    if (total_delta <= 0) {
      printf "0.0"
    } else {
      printf "%.1f", (100 * (total_delta - idle_delta) / total_delta)
    }
  }'
}

positive_number() {
  [[ "$1" =~ ^[0-9]+([.][0-9]+)?([eE][+-]?[0-9]+)?$ ]] &&
    awk -v value="$1" 'BEGIN { exit !(value > 0 && value < 1000000000000000) }'
}

bounded_integer() {
  local value="$1" fallback="$2" minimum="$3" maximum="$4"
  if [[ "${value}" =~ ^[1-9][0-9]{0,3}$ ]] && (( value >= minimum && value <= maximum )); then
    printf '%s' "${value}"
  else
    printf '%s' "${fallback}"
  fi
}

load_runtime_config() {
  if [[ -f "${CONFIG_FILE}" ]]; then
    # shellcheck disable=SC1090
    . "${CONFIG_FILE}"
  fi
  # Old ookla/auto configurations also use the RU-compatible backends.
  LIBRESPEED_SERVER_IDS="${SPEED_AUDIT_LIBRESPEED_SERVER_IDS:-}"
  LIBRESPEED_SERVERS_URL="${SPEED_AUDIT_LIBRESPEED_SERVERS_URL:-${DEFAULT_LIBRESPEED_SERVERS_URL}}"
  LIBRESPEED_IP_VERSION="${SPEED_AUDIT_LIBRESPEED_IP_VERSION:-4}"
  [[ "${LIBRESPEED_IP_VERSION}" == 6 ]] || LIBRESPEED_IP_VERSION=4
  HTTP_PROBE_URLS="${SPEED_AUDIT_HTTP_PROBE_URLS:-${DEFAULT_HTTP_PROBE_URLS}}"
  if [[ "${HTTP_PROBE_URLS}" == "https://mirror.yandex.ru/ubuntu/ls-lR.gz https://proof.ovh.net/files/100Mb.dat https://cachefly.cachefly.net/100mb.test https://download.docker.com/linux/ubuntu/dists/jammy/Release" ]]; then
    HTTP_PROBE_URLS="${DEFAULT_HTTP_PROBE_URLS}"
  fi
  NETWORK_SAMPLE_TARGET="$(bounded_integer "${SPEED_AUDIT_NET_SAMPLES:-3}" 3 1 5)"
  NETWORK_MAX_SERVERS="$(bounded_integer "${SPEED_AUDIT_NET_MAX_SERVERS:-8}" 8 1 20)"
  NETWORK_DURATION="$(bounded_integer "${SPEED_AUDIT_NET_DURATION:-8}" 8 3 20)"
  NETWORK_BUDGET="$(bounded_integer "${SPEED_AUDIT_NET_TIMEOUT:-180}" 180 30 600)"
}

reset_network_result() {
  NETWORK_ATTEMPTS=()
  NETWORK_SAMPLES=()
  NETWORK_TEST_OK=0
  NETWORK_TEST_BACKEND=""
  NETWORK_TEST_PROVIDER=""
  NETWORK_TEST_SERVER=""
  NETWORK_TEST_UPLOAD_SERVER=""
  NETWORK_TEST_PACKET_LOSS=""
  NETWORK_TEST_PING=""
  NETWORK_TEST_JITTER=""
  NETWORK_TEST_DOWNLOAD=""
  NETWORK_TEST_UPLOAD=""
  NETWORK_TEST_NOTE=""
  NETWORK_TEST_LIMITED=0
}

append_network_attempt() {
  NETWORK_ATTEMPTS+=("$1")
}

network_progress() {
  if [[ "${SPEED_AUDIT_QUIET:-0}" != 1 ]]; then
    printf '[Сеть] %s\n' "$1" >&2
  fi
}

run_network_command() {
  local limit="$1" remaining=$((NETWORK_DEADLINE - SECONDS))
  shift
  (( remaining > 0 )) || return 124
  (( limit <= remaining )) || limit="${remaining}"
  timeout --signal=TERM --kill-after=2 "${limit}s" "$@"
}

network_error() {
  local message
  message="$(head -n 1 "$1" | tr -d '\r' | cut -c 1-240)"
  printf '%s' "${message:-нет корректного результата или истекло время ожидания}"
}

format_speed_value() {
  awk -v value="$1" 'BEGIN {
    if (value >= 0.1) printf "%.1f", value;
    else printf "%.3g", value;
  }'
}

record_network_sample() {
  local backend="$1" server="$2" download="$3" upload="$4"
  local ping_value="$5" jitter="$6" loss="$7"
  positive_number "${download}" || return 1
  if [[ -n "${upload}" ]]; then
    positive_number "${upload}" || return 1
  fi
  local upload_text="нет данных"
  if [[ -n "${upload}" ]]; then upload_text="$(format_speed_value "${upload}") Мбит/с"; fi
  NETWORK_SAMPLES+=("${backend}, ${server}: загрузка $(format_speed_value "${download}") Мбит/с, отдача ${upload_text}")
  if [[ -z "${NETWORK_TEST_DOWNLOAD}" ]] || float_ge "${download}" "${NETWORK_TEST_DOWNLOAD}"; then
    NETWORK_TEST_BACKEND="${backend}"
    NETWORK_TEST_SERVER="${server}"
    NETWORK_TEST_DOWNLOAD="${download}"
    NETWORK_TEST_PING="${ping_value}"
    NETWORK_TEST_JITTER="${jitter}"
    NETWORK_TEST_PACKET_LOSS="${loss}"
  fi
  if [[ -n "${upload}" ]] && { [[ -z "${NETWORK_TEST_UPLOAD}" ]] || float_ge "${upload}" "${NETWORK_TEST_UPLOAD}"; }; then
    NETWORK_TEST_UPLOAD="${upload}"
    NETWORK_TEST_UPLOAD_SERVER="${server}"
  fi
  NETWORK_TEST_OK=1
}

parse_librespeed_result() {
  local input_file="$1" server_name="$2" download upload ping_value jitter
  # v1.0.13 JSON speeds are Mbps. Reject null, empty arrays, errors and zero rates.
  if ! jq -e '
    def root: if type == "array" and length == 1 then .[0] else . end;
    def rate: type == "number" and . > 0 and . < 1000000000;
    root | type == "object" and (.error? | not) and
      (.download | rate) and (.upload | rate)
  ' "${input_file}" >/dev/null 2>&1; then
    return 1
  fi
  download="$(jq -r 'if type == "array" then .[0].download else .download end' "${input_file}")"
  upload="$(jq -r 'if type == "array" then .[0].upload else .upload end' "${input_file}")"
  ping_value="$(jq -r '
    (if type == "array" then .[0] else . end) |
    (if (.ping | type) == "object" then .ping.latency else (.ping // .latency) end) |
    if type == "number" and . >= 0 then . else empty end
  ' "${input_file}")"
  jitter="$(jq -r '
    (if type == "array" then .[0] else . end) |
    (.jitter // (if (.ping | type) == "object" then .ping.jitter else null end)) |
    if type == "number" and . >= 0 then . else empty end
  ' "${input_file}")"
  record_network_sample "LibreSpeed" "${server_name}" "${download}" "${upload}" "${ping_value}" "${jitter}" ""
}

fetch_librespeed_servers() {
  local output_file="$1" error_file="$2"
  run_network_command 15 curl "-${LIBRESPEED_IP_VERSION}" -fsSL \
    --proto '=http,https' --proto-redir '=http,https' \
    --connect-timeout 4 --max-time 12 --max-filesize 2097152 \
    "${LIBRESPEED_SERVERS_URL}" -o "${output_file}" 2>"${error_file}" &&
    jq -e 'type == "array" and length > 0 and all(.[];
      (.id | type) == "number" and (.name | type) == "string" and (.server | type) == "string" and
      (.server | test("^https?://")) and (.pingURL | type) == "string")' \
      "${output_file}" >/dev/null 2>&1
}

librespeed_candidate_ids() {
  local servers_file="$1" id
  # Existing IDs from old configs retain priority; removed IDs are skipped.
  if [[ "${LIBRESPEED_SERVER_IDS}" =~ ^[0-9]+(,[0-9]+)*$ ]]; then
    while IFS= read -r id; do
      if jq -e --argjson id "${id}" 'any(.[]; .id == $id)' "${servers_file}" >/dev/null; then
        printf '%s\n' "${id}"
      fi
    done < <(printf '%s\n' "${LIBRESPEED_SERVER_IDS}" | tr ',' '\n')
  fi
  jq -r 'sort_by(if (.name | test("Russia|Moscow|Petersburg|Novosibirsk"; "i")) then 0
      elif (.name | test("Helsinki|Frankfurt|Amsterdam|Prague|Poznan|Belgrade"; "i")) then 1
      else 2 end) | .[].id' "${servers_file}"
}

collect_librespeed_json() {
  local output_file="$1" server_id="$2" servers_file="$3" error_file="$4"
  local limit=$((NETWORK_DURATION * 2 + 25))
  run_network_command "${limit}" librespeed-cli --json --no-icmp \
    --local-json "${servers_file}" --server "${server_id}" \
    "-${LIBRESPEED_IP_VERSION}" --timeout 5 --duration "${NETWORK_DURATION}" \
    >"${output_file}" 2>"${error_file}"
}

run_librespeed_network_test() {
  local servers_file="$1" work_dir="$2" server_id server_name ping_url
  local candidate_file="${work_dir}/candidates" result_file="${work_dir}/result.json"
  local error_file="${work_dir}/error" successful_ids=() successful_names=() index=0
  if ! command_exists librespeed-cli || ! command_exists jq; then
    append_network_attempt 'LibreSpeed: клиент или jq не установлен'
    return 1
  fi
  if ! fetch_librespeed_servers "${servers_file}" "${error_file}"; then
    append_network_attempt "Список LibreSpeed: $(network_error "${error_file}")"
    return 1
  fi
  librespeed_candidate_ids "${servers_file}" | awk '!seen[$0]++' > "${candidate_file}"
  while IFS= read -r server_id; do
    (( index < NETWORK_MAX_SERVERS && SECONDS < NETWORK_DEADLINE )) || break
    index=$((index + 1))
    server_name="$(jq -r --argjson id "${server_id}" '.[] | select(.id == $id) | .name | gsub("[[:cntrl:]]"; "")' "${servers_file}")"
    ping_url="$(jq -r --argjson id "${server_id}" '.[] | select(.id == $id) | (.server | rtrimstr("/")) + "/" + (.pingURL | ltrimstr("/"))' "${servers_file}")"
    network_progress "Проверяю ${server_name}"
    if ! run_network_command 5 curl "-${LIBRESPEED_IP_VERSION}" -fsSL \
      --proto '=http,https' --proto-redir '=http,https' --connect-timeout 3 --max-time 4 \
      --max-filesize 65536 -o /dev/null "${ping_url}" 2>"${error_file}"; then
      append_network_attempt "LibreSpeed ${server_id}: $(network_error "${error_file}")"
      continue
    fi
    if collect_librespeed_json "${result_file}" "${server_id}" "${servers_file}" "${error_file}" &&
      parse_librespeed_result "${result_file}" "${server_name}"; then
      successful_ids+=("${server_id}")
      successful_names+=("${server_name}")
      network_progress "Успешных замеров: ${#NETWORK_SAMPLES[@]}/${NETWORK_SAMPLE_TARGET}"
      (( ${#NETWORK_SAMPLES[@]} < NETWORK_SAMPLE_TARGET )) || return 0
    else
      append_network_attempt "LibreSpeed ${server_id}: $(network_error "${error_file}")"
    fi
  done < "${candidate_file}"
  # If only one or two endpoints work, repeat those to obtain three measurements.
  index=0
  while (( ${#successful_ids[@]} > 0 && ${#NETWORK_SAMPLES[@]} < NETWORK_SAMPLE_TARGET && SECONDS < NETWORK_DEADLINE )); do
    server_id="${successful_ids[index]}"
    server_name="${successful_names[index]}"
    network_progress "Повторный замер: ${server_name}"
    if ! collect_librespeed_json "${result_file}" "${server_id}" "${servers_file}" "${error_file}" ||
      ! parse_librespeed_result "${result_file}" "${server_name}"; then
      append_network_attempt "Повтор LibreSpeed ${server_id}: $(network_error "${error_file}")"
      break
    fi
    index=$(((index + 1) % ${#successful_ids[@]}))
  done
  [[ "${NETWORK_TEST_OK}" -eq 1 ]]
}

host_from_url() {
  printf '%s\n' "$1" | sed -E 's#^[a-zA-Z]+://([^/]+)/?.*$#\1#; s/:[0-9]+$//'
}

probe_host_latency() {
  local output
  command_exists ping || return 1
  output="$(run_network_command 5 ping "-${LIBRESPEED_IP_VERSION}" -c 3 -W 1 "$1" 2>/dev/null)" || return 1
  printf '%s\n' "${output}" | awk -F'/' '/rtt|round-trip/ {print $5}'
}

run_http_probe_test() {
  local work_dir="$1" url stats code http_code bytes raw_speed elapsed content_type download
  local error_file="${work_dir}/http-error" successful_urls=() candidates=() index=0 pass
  command_exists curl || return 1
  for url in ${HTTP_PROBE_URLS}; do candidates+=("${url}"); done
  for pass in 1 2; do
    if (( pass == 2 )); then
      (( ${#successful_urls[@]} > 0 )) || break
      candidates=("${successful_urls[@]}")
    fi
    for url in "${candidates[@]}"; do
      (( SECONDS < NETWORK_DEADLINE )) || break
      network_progress "HTTP-замер: $(host_from_url "${url}")"
      code=0
      stats="$(run_network_command 11 curl "-${LIBRESPEED_IP_VERSION}" -fLsS \
        --proto '=http,https' --proto-redir '=http,https' --connect-timeout 3 --max-time 9 \
        --range 0-33554431 --max-filesize 134217728 -H 'Cache-Control: no-cache' \
        -o /dev/null -w '%{http_code}|%{size_download}|%{speed_download}|%{time_total}|%{content_type}' \
        "${url}" 2>"${error_file}")" || code=$?
      IFS='|' read -r http_code bytes raw_speed elapsed content_type <<< "${stats}"
      if { [[ "${code}" == 0 ]] || [[ "${code}" == 28 ]]; } &&
        [[ "${http_code}" =~ ^20[06]$ ]] &&
        [[ "${bytes}" =~ ^[0-9]+$ ]] && (( bytes >= 5242880 )) &&
        positive_number "${raw_speed}" && positive_number "${elapsed}" &&
        { [[ "${code}" == 0 ]] || float_ge "${elapsed}" 3; } &&
        [[ "${content_type}" != *text/html* && "${content_type}" != *json* && "${content_type}" != *xml* ]]; then
        download="$(awk -v raw="${raw_speed}" 'BEGIN {printf "%.9f", raw * 8 / 1000000}')"
        record_network_sample 'HTTP-загрузка' "$(host_from_url "${url}")" "${download}" '' '' '' ''
        if (( pass == 1 )); then successful_urls+=("${url}"); fi
        (( ${#NETWORK_SAMPLES[@]} < NETWORK_SAMPLE_TARGET )) || return 0
      else
        append_network_attempt "HTTP $(host_from_url "${url}"): $(network_error "${error_file}"); HTTP=${http_code:-нет}, байт=${bytes:-0}"
      fi
    done
    (( ${#NETWORK_SAMPLES[@]} < NETWORK_SAMPLE_TARGET )) || break
    # Repeat a working endpoint enough times even when it is the only one available.
    if (( pass == 1 && ${#successful_urls[@]} > 0 )); then
      while (( ${#successful_urls[@]} < NETWORK_SAMPLE_TARGET )); do successful_urls+=("${successful_urls[0]}"); done
    fi
  done
  [[ "${NETWORK_TEST_OK}" -eq 1 ]]
}

cleanup_network_files() {
  if [[ -n "${NETWORK_WORK_DIR:-}" ]]; then
    rm -rf -- "${NETWORK_WORK_DIR}"
    NETWORK_WORK_DIR=""
  fi
}

run_best_network_test() {
  reset_network_result
  if ! command_exists timeout; then
    append_network_attempt 'Для ограничения времени нужна команда timeout из coreutils'
    return 1
  fi
  NETWORK_DEADLINE=$((SECONDS + NETWORK_BUDGET))
  NETWORK_WORK_DIR="$(mktemp -d)" || return 1
  network_progress "До ${NETWORK_SAMPLE_TARGET} успешных замеров, лимит ${NETWORK_BUDGET} с. Ookla не используется."
  if ! run_librespeed_network_test "${NETWORK_WORK_DIR}/servers.json" "${NETWORK_WORK_DIR}"; then
    run_http_probe_test "${NETWORK_WORK_DIR}" || true
  fi
  if [[ "${NETWORK_TEST_OK}" -eq 1 && -z "${NETWORK_TEST_UPLOAD}" ]]; then
    NETWORK_TEST_LIMITED=1
    NETWORK_TEST_PING="$(probe_host_latency "${NETWORK_TEST_SERVER}" || true)"
    NETWORK_TEST_NOTE='Измерена только HTTP-загрузка. Отдача и jitter не измерены; время ответа HTTP не подменяет ping.'
  fi
  if (( ${#NETWORK_SAMPLES[@]} < NETWORK_SAMPLE_TARGET )); then
    NETWORK_TEST_NOTE="${NETWORK_TEST_NOTE:+${NETWORK_TEST_NOTE} }Успешных замеров: ${#NETWORK_SAMPLES[@]} из ${NETWORK_SAMPLE_TARGET}."
  fi
  cleanup_network_files
  [[ "${NETWORK_TEST_OK}" -eq 1 ]]
}

print_network_attempts() {
  if ((${#NETWORK_ATTEMPTS[@]} > 0)); then
    printf 'Неудачные проверки:\n'
    printf ' - %s\n' "${NETWORK_ATTEMPTS[@]}"
  fi
}

print_network_result() {
  printf 'Метод проверки: %s\n' "${NETWORK_TEST_BACKEND}"
  printf 'Успешных замеров: %s\n' "${#NETWORK_SAMPLES[@]}"
  printf 'Сервер максимальной загрузки: %s\n' "${NETWORK_TEST_SERVER}"
  if [[ -n "${NETWORK_TEST_PING}" ]]; then printf 'Пинг к этому серверу: %.1f мс\n' "${NETWORK_TEST_PING}";
  else printf 'Пинг: нет данных\n'; fi
  if [[ -n "${NETWORK_TEST_JITTER}" ]]; then printf 'Jitter к этому серверу: %.1f мс\n' "${NETWORK_TEST_JITTER}";
  else printf 'Jitter: нет данных\n'; fi
  if [[ -n "${NETWORK_TEST_PACKET_LOSS}" ]]; then printf 'Потери пакетов: %.1f%%\n' "${NETWORK_TEST_PACKET_LOSS}";
  else printf 'Потери пакетов: нет данных\n'; fi
  printf 'Загрузка, измеренный максимум: %s Мбит/с\n' "$(format_speed_value "${NETWORK_TEST_DOWNLOAD}")"
  if [[ -n "${NETWORK_TEST_UPLOAD}" ]]; then
    printf 'Отдача, измеренный максимум: %s Мбит/с\n' "$(format_speed_value "${NETWORK_TEST_UPLOAD}")"
    printf 'Сервер максимальной отдачи: %s\n' "${NETWORK_TEST_UPLOAD_SERVER}"
  else printf 'Отдача: нет данных\n'; fi
  printf 'Результаты отдельных замеров:\n'
  printf ' - %s\n' "${NETWORK_SAMPLES[@]}"
  printf 'Примечание: максимум получен на доступных маршрутах; это не гарантия скорости до любого адреса.\n'
  if [[ -n "${NETWORK_TEST_NOTE}" ]]; then printf '%s\n' "${NETWORK_TEST_NOTE}"; fi
  print_network_attempts
}

require_root_for_action() {
  if [[ "${EUID}" -ne 0 ]]; then
    printf 'Для этого действия нужен root. Запустите команду через sudo.\n'
    return 1
  fi

  return 0
}

count_old_temp_files() {
  find /tmp /var/tmp -mindepth 1 -type f -mtime +3 2>/dev/null | wc -l | awk '{print $1}'
}

count_old_empty_temp_dirs() {
  find /tmp /var/tmp -mindepth 1 -type d -empty -mtime +3 2>/dev/null | wc -l | awk '{print $1}'
}

clean_apt_cache_impl() {
  require_root_for_action || return 1
  apt-get clean
  printf 'Кеш apt очищен. Текущий размер: %s\n' "$(format_mb "$(dir_size_mb /var/cache/apt)")"
}

vacuum_logs_impl() {
  require_root_for_action || return 1

  if command_exists journalctl; then
    journalctl --vacuum-time=7d
  else
    printf 'Команда journalctl недоступна, журналы systemd пропущены.\n'
  fi

  printf 'Текущий размер /var/log: %s\n' "$(format_mb "$(dir_size_mb /var/log)")"
}

cleanup_temp_impl() {
  local before_files before_dirs after_files after_dirs removed_files removed_dirs

  require_root_for_action || return 1

  before_files="$(count_old_temp_files)"
  before_dirs="$(count_old_empty_temp_dirs)"

  find /tmp /var/tmp -mindepth 1 -type f -mtime +3 -delete 2>/dev/null || true
  find /tmp /var/tmp -mindepth 1 -type d -empty -mtime +3 -delete 2>/dev/null || true

  after_files="$(count_old_temp_files)"
  after_dirs="$(count_old_empty_temp_dirs)"

  removed_files=$((before_files - after_files))
  removed_dirs=$((before_dirs - after_dirs))

  printf 'Удалено старых временных файлов: %d\n' "${removed_files}"
  printf 'Удалено пустых временных каталогов: %d\n' "${removed_dirs}"
  printf 'Текущий размер /tmp: %s, /var/tmp: %s\n' \
    "$(format_mb "$(dir_size_mb /tmp)")" \
    "$(format_mb "$(dir_size_mb /var/tmp)")"
}

run_safe_cleanup_impl() {
  clean_apt_cache_impl || return 1
  vacuum_logs_impl || return 1
  cleanup_temp_impl || return 1
}

show_largest_directories_impl() {
  printf 'Самые тяжелые каталоги в корне:\n'
  du -xhd1 / 2>/dev/null | sort -hr | head -n 12
  printf '\nСамые тяжелые каталоги в /var:\n'
  du -xhd1 /var 2>/dev/null | sort -hr | head -n 12
}

show_top_cpu_processes_impl() {
  printf 'Самые нагруженные процессы по CPU:\n'
  ps -eo pid,user,comm,%cpu,%mem --sort=-%cpu | head -n 12
}

show_top_mem_processes_impl() {
  printf 'Самые прожорливые процессы по RAM:\n'
  ps -eo pid,user,comm,%mem,%cpu --sort=-%mem | head -n 12
}

rerun_network_test_impl() {
  load_runtime_config

  if run_best_network_test; then
    printf 'Повторный сетевой тест завершен.\n'
    print_network_result
  else
    printf 'Не удалось измерить скорость через LibreSpeed и HTTP. Данные недоступны.\n'
    print_network_attempts
    return 1
  fi
}

repeat_full_audit_impl() {
  SPEED_AUDIT_SKIP_MENU=1 "$0"
}

add_menu_action() {
  MENU_KEYS+=("$1")
  MENU_TITLES+=("$2")
  MENU_DESCRIPTIONS+=("$3")
}

build_action_menu() {
  local cpu_usage="$1"
  local load_per_core="$2"
  local mem_used_pct="$3"
  local disk_used_pct="$4"
  local junk_total_mb="$5"

  MENU_KEYS=()
  MENU_TITLES=()
  MENU_DESCRIPTIONS=()

  if (( junk_total_mb >= 256 )) || float_ge "${disk_used_pct}" "70"; then
    add_menu_action "safe_cleanup" "Быстрая безопасная очистка" "Чистит кеш apt, старые журналы и старые временные файлы."
    add_menu_action "clean_apt_cache" "Почистить кеш apt" "Освобождает место, занятое скачанными пакетами."
    add_menu_action "vacuum_logs" "Почистить старые журналы" "Оставляет недавние журналы systemd и уменьшает /var/log."
    add_menu_action "cleanup_temp" "Почистить временные файлы" "Удаляет старые файлы из /tmp и /var/tmp."
    add_menu_action "show_large_dirs" "Показать тяжелые каталоги" "Помогает найти, где именно съедается место."
  else
    add_menu_action "show_large_dirs" "Показать тяжелые каталоги" "Полезно для ручной оценки диска и мусора."
  fi

  if float_ge "${cpu_usage}" "60" || float_ge "${load_per_core}" "1.0"; then
    add_menu_action "show_top_cpu" "Показать процессы по CPU" "Показывает, кто сильнее всего грузит процессор."
  fi

  if float_ge "${mem_used_pct}" "70"; then
    add_menu_action "show_top_mem" "Показать процессы по RAM" "Показывает процессы, которые сильнее всего занимают память."
  fi

  if command_exists librespeed-cli || command_exists curl; then
    add_menu_action "rerun_network_test" "Повторить сетевой тест" "Снова проверяет канал с резервными серверами и методами."
  fi

  add_menu_action "repeat_full_audit" "Повторить полную проверку" "Снова пересчитывает отчет после ваших действий."
}

run_menu_action() {
  local action_key="$1"

  case "${action_key}" in
    safe_cleanup)
      run_safe_cleanup_impl
      ;;
    clean_apt_cache)
      clean_apt_cache_impl
      ;;
    vacuum_logs)
      vacuum_logs_impl
      ;;
    cleanup_temp)
      cleanup_temp_impl
      ;;
    show_large_dirs)
      show_largest_directories_impl
      ;;
    show_top_cpu)
      show_top_cpu_processes_impl
      ;;
    show_top_mem)
      show_top_mem_processes_impl
      ;;
    rerun_network_test)
      rerun_network_test_impl
      ;;
    repeat_full_audit)
      repeat_full_audit_impl
      ;;
    *)
      printf 'Неизвестное действие: %s\n' "${action_key}"
      return 1
      ;;
  esac
}

show_action_menu() {
  local cpu_usage="$1"
  local load_per_core="$2"
  local mem_used_pct="$3"
  local disk_used_pct="$4"
  local junk_total_mb="$5"
  local choice action_key menu_index

  if [[ "${SPEED_AUDIT_SKIP_MENU:-0}" == "1" ]] || [[ ! -t 0 ]] || [[ ! -t 1 ]]; then
    return 0
  fi

  build_action_menu "${cpu_usage}" "${load_per_core}" "${mem_used_pct}" "${disk_used_pct}" "${junk_total_mb}"

  if ((${#MENU_KEYS[@]} == 0)); then
    return 0
  fi

  while true; do
    print_block_title "Что можно сделать прямо сейчас"
    printf 'Выберите действие по номеру. Пустой Enter завершает работу.\n'
    printf '0. Завершить\n'

    for menu_index in "${!MENU_KEYS[@]}"; do
      printf '%d. %s\n' "$((menu_index + 1))" "${MENU_TITLES[menu_index]}"
      printf '   %s\n' "${MENU_DESCRIPTIONS[menu_index]}"
    done

    printf '\nВведите номер действия: '
    read -r choice || break

    choice="${choice//$'\r'/}"
    if [[ -z "${choice}" || "${choice}" == "0" ]]; then
      break
    fi

    if ! [[ "${choice}" =~ ^[0-9]{1,3}$ ]]; then
      printf 'Нужно ввести только номер действия.\n'
      pause_before_menu_return
      continue
    fi

    menu_index=$((10#${choice} - 1))
    if (( menu_index < 0 || menu_index >= ${#MENU_KEYS[@]} )); then
      printf 'Такого номера в меню нет.\n'
      pause_before_menu_return
      continue
    fi

    action_key="${MENU_KEYS[menu_index]}"
    printf '\n'
    run_menu_action "${action_key}" || true
    pause_before_menu_return
  done
}

print_overall_assessment() {
  local overall_points="$1"
  if [[ "${NETWORK_TEST_OK}" -ne 1 ]]; then
    printf 'Общая проверка не завершена: скорость сети измерить не удалось. Оценки CPU, памяти и диска приведены выше.\n'
  elif [[ "${NETWORK_TEST_LIMITED}" -eq 1 ]]; then
    printf 'Проверка сети частичная: известна только скорость загрузки. Оценки ресурсов приведены выше.\n'
  elif (( ${#NETWORK_SAMPLES[@]} < NETWORK_SAMPLE_TARGET )); then
    printf 'Проверка сети ограничена: успешных замеров %s из %s. Оценки ресурсов приведены выше.\n' "${#NETWORK_SAMPLES[@]}" "${NETWORK_SAMPLE_TARGET}"
  elif (( overall_points == 0 )); then
    printf 'Все в порядке, сервер можно использовать.\n'
  elif (( overall_points <= 5 )); then
    printf 'Сервер в рабочем состоянии, но за ресурсами уже стоит наблюдать.\n'
  else
    printf 'Серверу желательно уделить внимание: есть признаки перегрузки или нехватки ресурсов.\n'
  fi
}

main() {
  local hostname_now timestamp os_name kernel_name uptime_human cpu_model cpu_cores
  local load1 load5 load15 load_avg load_per_core
  local cpu_usage cpu_status cpu_advice
  local mem_total_mb mem_used_mb mem_available_mb mem_used_pct mem_status mem_advice
  local disk_total_mb disk_used_mb disk_free_mb disk_used_pct disk_status disk_advice
  local apt_cache_mb tmp_mb vartmp_mb varlog_mb junk_total_mb junk_status junk_advice
  local overall_points=0
  local recommendations=()
  local net_status="Сетевой тест не запускался."
  local net_advice="Проверить настройки сетевого режима."

  load_runtime_config

  hostname_now="$(hostname 2>/dev/null || echo "неизвестно")"
  timestamp="$(date '+%Y-%m-%d %H:%M:%S %Z')"
  os_name="$(. /etc/os-release 2>/dev/null && printf '%s %s' "${NAME:-Linux}" "${VERSION_ID:-}")"
  kernel_name="$(uname -r 2>/dev/null || echo "неизвестно")"
  uptime_human="$(uptime -p 2>/dev/null | sed 's/^up //')"
  cpu_model="$(awk -F': ' '/model name/ {print $2; exit}' /proc/cpuinfo 2>/dev/null | trim)"
  cpu_model="${cpu_model:-неизвестно}"
  cpu_cores="$(nproc 2>/dev/null || echo "1")"
  read -r load1 load5 load15 _ < /proc/loadavg
  load_avg="$(printf '%s / %s / %s' "${load1}" "${load5}" "${load15}")"
  load_per_core="$(awk -v load1="${load1}" -v cores="${cpu_cores}" 'BEGIN {
    if (cores <= 0) {
      printf "0.00"
    } else {
      printf "%.2f", load1 / cores
    }
  }')"
  cpu_usage="$(cpu_usage_percent)"

  mem_total_mb="$(free -m | awk '/^Mem:/ {print $2}')"
  mem_used_mb="$(free -m | awk '/^Mem:/ {print $3}')"
  mem_available_mb="$(free -m | awk '/^Mem:/ {print $7}')"
  mem_used_pct="$(awk -v used="${mem_used_mb}" -v total="${mem_total_mb}" 'BEGIN {
    if (total <= 0) {
      printf "0.0"
    } else {
      printf "%.1f", (used * 100 / total)
    }
  }')"

  read -r disk_total_mb disk_used_mb disk_free_mb disk_used_pct < <(
    df -Pm / | awk 'NR == 2 {
      gsub(/%/, "", $5)
      print $2, $3, $4, $5
    }'
  )

  apt_cache_mb="$(dir_size_mb /var/cache/apt)"
  tmp_mb="$(dir_size_mb /tmp)"
  vartmp_mb="$(dir_size_mb /var/tmp)"
  varlog_mb="$(dir_size_mb /var/log)"
  junk_total_mb=$((apt_cache_mb + tmp_mb + vartmp_mb + varlog_mb))

  if float_ge "${cpu_usage}" "85" || float_ge "${load_per_core}" "1.50"; then
    cpu_status="Нагрузка на процессор уже высокая. Есть риск очереди задач и просадки по скорости."
    cpu_advice="Рекомендация: посмотреть самые тяжелые процессы и подумать о расширении по CPU."
    overall_points=$((overall_points + 2))
    recommendations+=("Проверить процессы, нагружающие CPU, и оценить необходимость расширения по ядрам.")
  elif float_ge "${cpu_usage}" "60" || float_ge "${load_per_core}" "1.00"; then
    cpu_status="Процессор в рабочей зоне, но нагрузка уже повышенная."
    cpu_advice="Рекомендация: понаблюдать за процессами и пиковыми часами работы."
    overall_points=$((overall_points + 1))
    recommendations+=("Следить за пиковыми периодами нагрузки на CPU и load average.")
  else
    cpu_status="Все в порядке, процессор не перегружен."
    cpu_advice="Рекомендация: текущего запаса процессора достаточно."
  fi

  if float_ge "${mem_used_pct}" "85"; then
    mem_status="Оперативная память занята сильно. Сервер близок к нехватке RAM."
    mem_advice="Рекомендация: увеличить объем памяти или разгрузить сервисы."
    overall_points=$((overall_points + 2))
    recommendations+=("Увеличить объем RAM или отключить лишние процессы.")
  elif float_ge "${mem_used_pct}" "70"; then
    mem_status="Память занята заметно, но запас еще есть."
    mem_advice="Рекомендация: следить, чтобы потребление RAM не росло дальше."
    overall_points=$((overall_points + 1))
    recommendations+=("Понаблюдать за ростом потребления оперативной памяти.")
  else
    mem_status="Память в норме, свободный запас есть."
    mem_advice="Рекомендация: по оперативной памяти расширение пока не требуется."
  fi

  if float_ge "${disk_used_pct}" "90"; then
    disk_status="Диск заполнен очень сильно. Это уже опасная зона."
    disk_advice="Рекомендация: срочно освобождать место или расширять диск."
    overall_points=$((overall_points + 2))
    recommendations+=("Освободить место на диске или увеличить объем хранилища.")
  elif float_ge "${disk_used_pct}" "75"; then
    disk_status="Диск заполнен заметно. Пока работать можно, но запас уменьшается."
    disk_advice="Рекомендация: почистить старые файлы и подготовить план расширения."
    overall_points=$((overall_points + 1))
    recommendations+=("Почистить диск и держать под контролем рост данных.")
  else
    disk_status="По диску все в порядке, свободное место есть."
    disk_advice="Рекомендация: срочное расширение диска не требуется."
  fi

  if (( junk_total_mb >= 3072 )); then
    junk_status="Служебного мусора уже много: кеши, временные файлы и журналы занимают заметный объем."
    junk_advice="Рекомендация: выполнить чистку /tmp, /var/tmp, /var/log и кеша apt."
    overall_points=$((overall_points + 2))
    recommendations+=("Почистить временные файлы, журналы и кеш apt.")
  elif (( junk_total_mb >= 1024 )); then
    junk_status="Служебный мусор уже накопился, но ситуация пока не критичная."
    junk_advice="Рекомендация: планово почистить кеши и старые временные файлы."
    overall_points=$((overall_points + 1))
    recommendations+=("Сделать плановую чистку кешей и временных файлов.")
  else
    junk_status="Мусора немного, срочная чистка не нужна."
    junk_advice="Рекомендация: можно оставить как есть и чистить по расписанию."
  fi

  if run_best_network_test; then
    if [[ "${NETWORK_TEST_LIMITED}" -eq 1 ]]; then
      net_status="Частичная проверка: измерена только скорость загрузки через HTTP."
      net_advice="Рекомендация: повторить LibreSpeed для оценки отдачи и jitter."
      overall_points=$((overall_points + 1))
      recommendations+=("Полный сетевой замер недоступен; скорость отдачи неизвестна.")
    elif [[ -n "${NETWORK_TEST_PACKET_LOSS}" ]] && float_ge "${NETWORK_TEST_PACKET_LOSS}" "1.0"; then
      net_status="Канал работает нестабильно: есть заметные потери пакетов."
      net_advice="Рекомендация: проверить провайдера, маршрут и сетевую нагрузку."
      overall_points=$((overall_points + 2))
      recommendations+=("Проверить потери пакетов и стабильность сетевого канала.")
    elif [[ -n "${NETWORK_TEST_PING}" ]] && float_ge "${NETWORK_TEST_PING}" "100"; then
      net_status="Пинг высокий. Для чувствительных сервисов это уже нехорошо."
      net_advice="Рекомендация: проверить маршрут, регион сервера или сетевую перегрузку."
      overall_points=$((overall_points + 2))
      recommendations+=("Снизить сетевую задержку или перенести нагрузку ближе к пользователям.")
    elif [[ -n "${NETWORK_TEST_PING}" ]] && float_ge "${NETWORK_TEST_PING}" "60"; then
      net_status="Пинг повышенный, но для части задач еще допустимый."
      net_advice="Рекомендация: наблюдать за задержкой и jitter."
      overall_points=$((overall_points + 1))
      recommendations+=("Понаблюдать за пингом и стабильностью канала.")
    elif [[ -n "${NETWORK_TEST_DOWNLOAD}" ]] && float_le "${NETWORK_TEST_DOWNLOAD}" "30"; then
      net_status="Измеренная скорость загрузки низкая на проверенных маршрутах."
      net_advice="Рекомендация: сравнить результаты в другое время и проверить маршруты до тестовых узлов."
      overall_points=$((overall_points + 1))
      recommendations+=("Проверить тариф или ограничения по каналу связи.")
    elif [[ -n "${NETWORK_TEST_UPLOAD}" ]] && float_le "${NETWORK_TEST_UPLOAD}" "10"; then
      net_status="Скорость отдачи низкая. Это может мешать VPN, прокси или другим сетевым сервисам."
      net_advice="Рекомендация: проверить исходящий канал и ограничения у провайдера."
      overall_points=$((overall_points + 1))
      recommendations+=("Проверить скорость отдачи и ограничения исходящего канала.")
    else
      net_status="По скорости и задержке сеть выглядит нормально."
      net_advice="Рекомендация: канал можно использовать в текущем виде."
    fi
  else
    net_status="Не удалось измерить скорость через LibreSpeed и HTTP. Данные недоступны."
    net_advice="Рекомендация: проверить DNS, исходящий доступ в интернет и доступность внешних тестовых узлов."
    overall_points=$((overall_points + 2))
    recommendations+=("Проверить исходящий доступ к внешним тестовым серверам и DNS-настройки.")
  fi

  print_line
  printf '%s %s\n' "${APP_NAME}" "v${APP_VERSION}"
  print_line
  printf 'Дата проверки: %s\n' "${timestamp}"
  printf 'Сервер: %s\n' "${hostname_now}"
  printf 'Система: %s\n' "${os_name:-Linux}"
  printf 'Ядро: %s\n' "${kernel_name}"
  printf 'Время работы: %s\n' "${uptime_human:-неизвестно}"

  print_block_title "Системные ресурсы"
  printf 'Процессор: %s\n' "${cpu_model}"
  printf 'Количество ядер: %s\n' "${cpu_cores}"
  printf 'Текущая загрузка процессора: %s\n' "$(format_percent "${cpu_usage}")"
  printf 'Load average: %s\n' "${load_avg}"
  printf 'Load на одно ядро: %s\n' "${load_per_core}"
  printf 'Оценка: %s\n' "${cpu_status}"
  printf '%s\n' "${cpu_advice}"
  printf '\n'
  printf 'Оперативная память занято: %s из %s (%s)\n' \
    "$(format_mb "${mem_used_mb}")" \
    "$(format_mb "${mem_total_mb}")" \
    "$(format_percent "${mem_used_pct}")"
  printf 'Оперативная память доступно: %s\n' "$(format_mb "${mem_available_mb}")"
  printf 'Оценка: %s\n' "${mem_status}"
  printf '%s\n' "${mem_advice}"
  printf '\n'
  printf 'Диск занято: %s из %s (%s)\n' \
    "$(format_mb "${disk_used_mb}")" \
    "$(format_mb "${disk_total_mb}")" \
    "$(format_percent "${disk_used_pct}")"
  printf 'Диск свободно: %s\n' "$(format_mb "${disk_free_mb}")"
  printf 'Оценка: %s\n' "${disk_status}"
  printf '%s\n' "${disk_advice}"
  printf '\n'
  printf 'Служебный мусор всего: %s\n' "$(format_mb "${junk_total_mb}")"
  printf 'Кеш apt: %s, /tmp: %s, /var/tmp: %s, /var/log: %s\n' \
    "$(format_mb "${apt_cache_mb}")" \
    "$(format_mb "${tmp_mb}")" \
    "$(format_mb "${vartmp_mb}")" \
    "$(format_mb "${varlog_mb}")"
  printf 'Оценка: %s\n' "${junk_status}"
  printf '%s\n' "${junk_advice}"

  print_block_title "Сеть и задержка"
  if [[ "${NETWORK_TEST_OK}" -eq 1 ]]; then
    print_network_result
  else
    printf 'Данные сетевого теста: недоступны\n'
    print_network_attempts
  fi
  printf 'Оценка: %s\n' "${net_status}"
  printf '%s\n' "${net_advice}"

  print_block_title "Итоговая оценка"
  print_overall_assessment "${overall_points}"

  if ((${#recommendations[@]} > 0)); then
    printf '\nРекомендации:\n'
    printf ' - %s\n' "${recommendations[@]}"
  fi

  print_line

  show_action_menu "${cpu_usage}" "${load_per_core}" "${mem_used_pct}" "${disk_used_pct}" "${junk_total_mb}"
}

if [[ "${BASH_SOURCE[0]:-$0}" == "$0" ]]; then
  export LC_NUMERIC=C
  trap cleanup_network_files EXIT
  main "$@"
fi
